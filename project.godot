; Project Evacuation — open with the pinned Godot Standard editor.
config_version=5

[application]
config/name="Project Evacuation"
config/description="A free first-person physics puzzle game. Foundation build."
config/version="0.0.10-dev"
config/auto_accept_quit=false
run/main_scene="res://src/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]
settings/gdscript/always_track_call_stacks=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[display]
window/size/mode=3
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
restart_test={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
walk={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194328)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
throw_prop={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Props"
3d_physics/layer_3="Player"
3d_physics/layer_4="Traversal volumes"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver="vulkan"
rendering_device/driver.windows="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
textures/default_filters/use_nearest_mipmap_filter=false
