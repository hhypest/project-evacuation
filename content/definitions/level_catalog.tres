[gd_resource type="Resource" script_class="LevelCatalog" format=3]

[ext_resource type="Script" path="res://src/infrastructure/content/level_entry.gd" id="1"]
[ext_resource type="PackedScene" path="res://content/levels/mechanics_lab.tscn" id="2"]
[ext_resource type="Script" path="res://src/infrastructure/content/level_catalog.gd" id="3"]
[ext_resource type="PackedScene" path="res://content/levels/reserve_circuit.tscn" id="4"]

[ext_resource type="Resource" path="res://content/definitions/reserve_checkpoint.tres" id="5"]
[ext_resource type="Script" path="res://src/infrastructure/content/chamber_checkpoint.gd" id="6"]
[ext_resource type="PackedScene" path="res://content/levels/oxygen_training.tscn" id="7"]
[ext_resource type="PackedScene" path="res://content/levels/qualification_route.tscn" id="8"]
[ext_resource type="Resource" path="res://content/definitions/oxygen_checkpoint.tres" id="9"]
[ext_resource type="Resource" path="res://content/definitions/route_checkpoint.tres" id="10"]

[sub_resource type="Resource" id="UnifiedLab"]
script = ExtResource("1")
level_id = &"mechanics_lab"
title = "Единый полигон: все механики"
summary = "Хаб и семь отсеков: движение, перенос, устройства, оптика, гравитация, порталы, динамический свет и тени. R сбрасывает весь полигон."
scene = ExtResource("2")

[sub_resource type="Resource" id="ReserveCircuit"]
script = ExtResource("1")
level_id = &"reserve_circuit"
title = "Резервный контур"
summary = "Камера с двумя источниками питания портала, оптической блокировкой и выходным шлюзом."
scene = ExtResource("4")
checkpoints = Array[ExtResource("6")]([ExtResource("5")])

[sub_resource type="Resource" id="OxygenTraining"]
script = ExtResource("1")
level_id = &"oxygen_training"
title = "Контур дыхания: кислород и опасность"
scene = ExtResource("7")
checkpoints = Array[ExtResource("6")]([ExtResource("9")])

[sub_resource type="Resource" id="QualificationRoute"]
script = ExtResource("1")
level_id = &"qualification_route"
title = "Квалификационный маршрут"
scene = ExtResource("8")
checkpoints = Array[ExtResource("6")]([ExtResource("10")])

[resource]
script = ExtResource("3")
entries = Array[ExtResource("1")]([SubResource("UnifiedLab"), SubResource("ReserveCircuit"), SubResource("OxygenTraining"), SubResource("QualificationRoute")])
